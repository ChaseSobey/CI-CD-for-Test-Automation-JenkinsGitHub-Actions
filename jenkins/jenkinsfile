pipeline {
    agent any

    stages {
        stage('Execute Unit Tests') {
            parallel {
                stage('Unit Tests - Backend') {
                    agent {
                        docker {
                            image 'golang:1.21'
                            reuseNode true
                        }
                    }
                    environment {
                        // Inside this container $HOME is "/", and the agent runs as uid 1000,
                        // which cannot write to the filesystem root. Point Go's caches at
                        // /tmp (world-writable) so the build/module caches can be created.
                        HOME    = '/tmp'
                        GOCACHE = '/tmp/go-build'
                        GOPATH  = '/tmp/go'
                    }
                    steps {
                        dir('bugtracker-backend') {
                            sh '''
                                # Install the JUnit converter into $GOPATH/bin and add it to PATH.
                                export PATH="$GOPATH/bin:$PATH"
                                go install github.com/jstemmer/go-junit-report/v2@latest
                                # Convert `go test -v` output to JUnit XML at the path the
                                # `junit` post-step expects. -set-exit-code makes the stage
                                # fail when tests fail (a plain pipe would mask that).
                                go test -v ./... 2>&1 | go-junit-report -set-exit-code > test-results.xml

                                # generate a coverage report
                                go test -coverprofile=coverage.out -covermode=atomic ./...
                                go tool cover -html=coverage.out -o coverage.html

                                mkdir -p reports
                                mv coverage.html reports/
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-backend/test-results.xml'
                            publishHTML(target: [
                                allowMissing: true,
                                reportDir: 'bugtracker-backend/reports',
                                reportFiles: 'coverage.html',
                                reportName: 'Backend Coverage Report'
                            ])
                        }
                    }
                }
                stage('Unit Tests - Frontend') {
                    agent {
                        docker {
                            image 'node:20-alpine'
                            reuseNode true
                        }
                    }
                    steps {
                        dir('bugtracker-frontend') {
                            sh '''
                                npm ci
                                npm test
                            '''
                        }
                    }
                    post {
                        always {
                            junit 'bugtracker-frontend/test-results.xml'
                            publishHTML(target: [
                                allowMissing: true,
                                reportDir: 'bugtracker-frontend/coverage',
                                reportFiles: 'index.html',
                                reportName: 'Frontend Coverage Report'
                            ])
                        }
                    }
                }
            }
        }
        
        stage('Launch Application') {
            // Run on the built-in node (the controller): it already has the Docker
            // CLI, Compose v5.8, and a working TLS connection to the dind daemon.
            // A `docker` agent for this stage hangs Jenkins' step launch, so avoid it.
            environment {
                DOCKER_HOST       = 'tcp://docker:2376'
                DOCKER_TLS_VERIFY = '1'
                DOCKER_CERT_PATH  = '/certs/client'
            }
            steps {
                sh 'docker compose up --build --wait'
            }
        }

        stage('API Tests') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    // The plugin already runs the container as uid 1000 (the workspace
                    // owner). Do NOT add '-u 0': root-owned files break cleanWs/junit and
                    // can reproduce the docker-agent step-launch hang.
                    args '--network=host'
                }
            }
            environment {
                // We run as uid 1000 (the plugin default), but the Playwright image's HOME
                // belongs to pwuser, so npm can't write its cache there. Point it at /tmp.
                HOME             = '/tmp'
                npm_config_cache = '/tmp/.npm'
            }
            steps {
                dir('tests-api') {
                    // Install first so npx resolves wait-port and playwright from the local
                    // node_modules instead of prompting to download them in CI.
                    sh 'npm ci'
                    // Then wait for the app's health endpoint (it should already be up from
                    // the Launch stage's --wait, so this is a cheap safeguard).
                    sh 'npx wait-port http://localhost:8080/api/health -t 30000'
                    sh 'npx playwright test'
                }
            }
            post {
                always {
                    // Publish the reports playwright.config.ts already generates.
                    junit testResults: 'tests-api/test-results/results.xml', allowEmptyResults: true
                    publishHTML(target: [
                        allowMissing: true,
                        reportDir: 'tests-api/playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'API Test Report'
                    ])
                }
            }
        }

        stage('E2E Tests') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.50.0-jammy'
                    reuseNode true
                    // Browser tests need a large enough /dev/shm (--ipc=host) or Chromium
                    // crashes. --network=host reaches the app via localhost (ports are
                    // published on the dind host).
                    args '--network=host --ipc=host'
                }
            }
            environment {
                // Run as uid 1000 (the plugin default). Writable npm cache, and CI=true so
                // playwright.config.ts runs headless (there's no display in the container).
                HOME             = '/tmp'
                npm_config_cache = '/tmp/.npm'
                CI               = 'true'
            }
            steps {
                dir('tests-e2e') {
                    sh 'npm ci'
                    sh 'npx playwright test'
                }
            }
            post {
                always {
                    junit testResults: 'tests-e2e/test-results/results.xml', allowEmptyResults: true
                    publishHTML(target: [
                        allowMissing: true,
                        reportDir: 'tests-e2e/playwright-report',
                        reportFiles: 'index.html',
                        reportName: 'E2E Test Report'
                    ])
                }
            }
        }
    }
    post {
        always {
            // Tear the app down here, not in a stage: a stage after the tests would be
            // skipped if any test stage fails - exactly when containers get orphaned on
            // dind. This runs on every build result, using the compose file before
            // cleanWs removes the workspace.
            withEnv([
                'DOCKER_HOST=tcp://docker:2376',
                'DOCKER_TLS_VERIFY=1',
                'DOCKER_CERT_PATH=/certs/client'
            ]) {
                sh 'docker compose down --remove-orphans || true'
            }
            cleanWs()
        }
    }
}
